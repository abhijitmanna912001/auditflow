NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Optional Google Drive connection. Leave all three empty to hide it.
# These are browser-visible identifiers, not secrets: restrict the API key by
# website and API in Google Cloud. Never add a client secret or a token here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
# The numeric Google Cloud project number.
NEXT_PUBLIC_GOOGLE_APP_ID=
